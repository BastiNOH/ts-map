<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kommandozeilen-Version von ts-map: liest die aktiven Mods (inkl. Reihenfolge) aus dem
    Spielerprofil und rendert die Kachelkarte ohne GUI. Nutzt die Quellen aus ../TsMap direkt.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TsMap.Cli</AssemblyName>
    <RootNamespace>TsMap.Cli</RootNamespace>
    <!-- Die TsMap-Quellen nutzen System.Drawing, das unter .NET nur auf Windows läuft. -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB0021;SYSLIB0023</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TsMap\**\*.cs" Exclude="..\TsMap\Properties\**;..\TsMap\obj\**;..\TsMap\bin\**" Link="TsMap\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\libs\libdeflate.dll" Link="libdeflate.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\custom_resources.zip" Link="custom_resources.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
